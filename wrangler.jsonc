{
  // Botica Natural — site estático servido por Cloudflare Workers Static Assets.
  // Publica SOMENTE o pacote limpo gerado por `npm run build:cf` em ./dist
  // (sem docs/, supabase/, scripts/, tests/, .github/, *.md, package.json).
  // Workers Builds: Build command = `npm run build:cf` | Deploy command = `npx wrangler deploy`
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loja-botica-natural",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    // Rotas inexistentes respondem 404 com dist/404.html
    "not_found_handling": "404-page",
    // /admin → admin.html, /produtos/<slug>/ → produtos/<slug>/index.html
    "html_handling": "auto-trailing-slash"
  }
}
