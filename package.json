{
  "name": "botica-natural",
  "version": "1.0.0",
  "private": true,
  "description": "Botica Natural — Farmácia de Manipulação (Site estático e Painel Administrativo)",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-richtext.mjs && node scripts/test-urlsafety.mjs && node scripts/test-security.mjs && node scripts/verify.mjs",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:prod": "node scripts/verify.mjs --prod",
    "build:vendor": "node scripts/bundle-vendor.mjs",
    "build:icons": "node scripts/build-icons-sprite.mjs",
    "build:products": "node scripts/build-products.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "build:pages": "node scripts/build-products.mjs && node scripts/build-cf.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.65.1",
    "@supabase/supabase-js": "^2.119.2",
    "esbuild": "^0.28.2"
  }
}
